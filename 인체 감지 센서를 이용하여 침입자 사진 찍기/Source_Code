from gpiozero import MotionSensor  # gpiozero 라이브러리에 모션센서 클래스를 가져옴
import time                        # time 라이브러리를 가져옴
from picamera2 import Picamera2    # picamera2 라이브러리에서 Picamera2 클래스를 가져옴
import datetime                    # 시간과 날짜를 위해 datetime 라이브러리를 가져옴

pirPin = MotionSensor(16)          # GPIO 16번 핀을 PIR 모션 센서 입력 핀으로 초기화함.

picam2 = Picamera2()               # Picamera2()객체를 picam2에 대입
camera_config = picam2.create_preview_configuration()   # picam2의 create_priview_configuration() 메소드를 camera_config에 대입.
picam2.configure(camera_config)    # picam2의 configura() 객체에 위에 만든 camera_config를 넣음
picam2.start()                     # picam2의 start() 객체를 실행

try:
    while True:
        try:
            sensorValue = pirPin.value          # pirPin의 밸류를 센서밸류에 대입
            if sensorValue == 1:                # 센서밸류가 1인 경우 아래 문장 계속실행
                now = datetime.datetime.now()   # 현재 시간(날짜)을 now에 대
                print(now)                      # 현재시간 출력
                fileName = now.strftime('%y-%m-%d %H:%M:%S')    # 시각을 파일명 형식 문자열로 변환
                picam2.capture_file(fileName + '.jpg')          # .jpg를 뒤에 붙임으로써 이미지파일로 촬영 및 저장 
                time.sleep(0.5)                 # 0.5초 텀두기

            except:                             # 오류 발생시 무시하고 계속 실행.
                pass

except KeyboardInterrupt:           # 컨트롤 + C 누르면 멈춤
    pass
