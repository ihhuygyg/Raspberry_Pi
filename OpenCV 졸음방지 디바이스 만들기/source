import cv2                         # OpenCV (영상 처리 및 얼굴/눈 인식)
from gpiozero import Buzzer        # GPIO 부저 제어 라이브러리
import time

buzzerPin = Buzzer(16)             # GPIO 16번 핀에 연결된 부저 객체 생성

def main():
    camera = cv2.VideoCapture(0)   # 카메라 장치 연결 (0: 기본 웹캠)
    camera.set(3, 640)             # 영상 가로 해상도 설정
    camera.set(4, 480)             # 영상 세로 해상도 설정

    # Haar Cascade 모델 파일 경로 (얼굴 / 눈 인식용)
    face_xml = cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
    eye_xml = cv2.data.haarcascades + 'haarcascade_eye.xml'

    face_cascade = cv2.CascadeClassifier(face_xml)   # 얼굴 인식 객체 생성
    eye_cascade = cv2.CascadeClassifier(eye_xml)     # 눈 인식 객체 생성

    while camera.isOpened():                         # 카메라가 정상 동작하는 동안 반복
        ret, image = camera.read()                   # 프레임 읽기
        if not ret:                                  # 프레임 읽기 실패 시 종료
            break

        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)  # 얼굴/눈 인식을 위해 흑백 변환

        # 얼굴 검출 (스케일, 정확도 설정 포함)
        faces = face_cascade.detectMultiScale(
            gray,
            scaleFactor=1.1,
            minNeighbors=5,
            minSize=(100, 100)
        )

        print("faces detected Number:", len(faces))  # 검출된 얼굴 개수 출력

        if len(faces):                               # 얼굴이 하나라도 있을 경우
            for (x, y, w, h) in faces:
                # 얼굴 영역에 사각형 표시
                cv2.rectangle(image, (x, y), (x+w, y+h), (255, 0, 0), 2)

                face_gray = gray[y:y+h, x:x+w]       # 얼굴 영역 (흑백)
                face_color = image[y:y+h, x:x+w]     # 얼굴 영역 (컬러)

                # 얼굴 영역에서 눈 검출
                eyes = eye_cascade.detectMultiScale(
                    face_gray,
                    scaleFactor=1.1,
                    minNeighbors=5
                )

                # 눈이 1개 이하이면 (눈 감음 또는 인식 실패) → 부저 ON
                if len(eyes) <= 1:
                    buzzerPin.on()
                else:
                    buzzerPin.off()

                # 검출된 눈 위치에 사각형 표시
                for (ex, ey, ew, eh) in eyes:
                    cv2.rectangle(face_color, (ex, ey), (ex+ew, ey+eh), (0, 255, 0), 2)

        cv2.imshow('result', image)                  # 결과 영상 출력

        if cv2.waitKey(1) == ord('q'):               # 'q' 키 입력 시 종료
            break

    camera.release()                                 # 카메라 자원 해제
    cv2.destroyAllWindows()                          # 모든 창 닫기
    buzzerPin.off()                                  # 종료 시 부저 OFF

if __name__ == '__main__':
    main()
